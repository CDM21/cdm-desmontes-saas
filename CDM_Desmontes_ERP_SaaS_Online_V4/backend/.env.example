# CDM Desmontes SaaS
# Local: o sistema usa localhost. Em produção no Render, PUBLIC_BASE_URL pode
# ficar vazio porque o app usa RENDER_EXTERNAL_URL automaticamente.
SECRET_KEY=troque-por-uma-chave-grande-e-secreta
APP_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=
DATABASE_URL=sqlite:///./cdm_desmontes.db

# Mercado Livre - credenciais da aplicação CDM
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Opcional. Se vazio em produção, será calculado pelo domínio público.
ML_REDIRECT_URI=

# Shopee Open Platform
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=

# OLX - integrador homologado
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
OLX_REDIRECT_URI=

# Cobrança mensal
BILLING_PROVIDER=
BILLING_WEBHOOK_SECRET=troque-este-segredo

# Mercado Pago - assinatura SaaS CDM
# Gere o Access Token na sua aplicação do Mercado Pago e salve somente no Render.
MP_ACCESS_TOKEN=
CDM_MONTHLY_PRICE=350
# Configure no Mercado Pago as notificações para:
# https://SEU-DOMINIO/api/billing/mercadopago/webhook

# Segurança
ALLOW_BOOTSTRAP=false

# Administração da plataforma
# E-mail(s) que podem abrir "Clientes da plataforma". Separe vários por vírgula.
# Use o mesmo e-mail usado para entrar no CDM; não coloque senha aqui.
PLATFORM_ADMIN_EMAILS=

# Assinatura Mercado Pago
# Recomendado para validar a assinatura das notificações recebidas.
MP_WEBHOOK_SECRET=

# NF-e — provedor fiscal real (configure quando contratar/homologar)
# URL do endpoint do provedor que receberá o JSON de emissão.
FISCAL_PROVIDER_URL=
FISCAL_PROVIDER_TOKEN=

# Assistente CDM (opcional: sem isso, funciona em modo de inteligência local)
OPENAI_API_KEY=
OPENAI_MODEL=
ASSISTANT_MONTHLY_MESSAGES=1000
